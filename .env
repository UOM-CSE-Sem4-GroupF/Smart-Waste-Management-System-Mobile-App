# WasteCollect Driver App — Environment Variables
# Copy this to .env.local and fill real values.
# NEVER commit .env.local to source control.

# ── Backend ────────────────────────────────────────────────────────────────────
API_BASE_URL=https://api.waste-mgmt.lk
WS_URL=wss://api.waste-mgmt.lk

# ── Keycloak ──────────────────────────────────────────────────────────────────
KEYCLOAK_REALM=waste-mgmt
KEYCLOAK_CLIENT_ID=driver-app
KEYCLOAK_BASE_URL=https://auth.waste-mgmt.lk

# ── MQTT ─────────────────────────────────────────────────────────────────────
MQTT_BROKER=mqtt.waste-mgmt.lk
# Port 8883 (TLS) is hardcoded in MqttService

# ── Mapbox / Tiles ────────────────────────────────────────────────────────────
# MAPBOX_TOKEN=pk.REPLACE_ME
# Tiles currently use OSM (free). Swap urlTemplate in FlutterMap to use Mapbox.

# ── Firebase ──────────────────────────────────────────────────────────────────
# Place google-services.json (Android) and GoogleService-Info.plist (iOS) in
# the platform directories. Do NOT store Firebase keys here.
